# Google Analytics 4 measurement ID. Get one from
#   https://analytics.google.com/ → Admin → Create property → Web stream.
# Copy this file to .env.local and fill in. Empty values disable GA entirely.
NEXT_PUBLIC_GA_ID=

# Optional: override where the trading bot writes its state JSON files.
# Defaults to ./data in the project root. Useful on container deploys.
# BOT_STATE_DIR=/var/lib/juicedtrade
