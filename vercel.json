{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/bot/run?market=IN",
      "schedule": "30 10 * * 1-5"
    },
    {
      "path": "/api/bot/run?market=US",
      "schedule": "0 22 * * 1-5"
    }
  ],
  "functions": {
    "src/app/api/bot/run/route.ts": { "maxDuration": 300 },
    "src/app/api/scan/route.ts": { "maxDuration": 60 },
    "src/app/api/etfs/route.ts": { "maxDuration": 60 }
  }
}
